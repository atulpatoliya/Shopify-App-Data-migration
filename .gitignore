# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────
/build/
/app/build/
/public/build/
/public/_dev/
/app/public/build/
/extensions/*/dist/
.react-router/

# ── Database ──────────────────────────────────────────────────
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite
*.sqlite
*.sqlite-journal

# ── Environment ───────────────────────────────────────────────
.env
.env.*
.env.local

# ── Shopify CLI ───────────────────────────────────────────────
.shopify/
.shopify.lock

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── Cache ─────────────────────────────────────────────────────
/.cache/
.eslintcache
*.tsbuildinfo

# ── Lock files (keep package-lock.json, ignore others) ────────
yarn.lock
pnpm-lock.yaml

# ── OS junk ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor configs ────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
.editorconfig
.cursor/

# ── Docker ────────────────────────────────────────────────────
# Dockerfile is needed for Render deployment — do NOT ignore it
.dockerignore

# ── Docs / Boilerplate ────────────────────────────────────────
README.md
CHANGELOG.md